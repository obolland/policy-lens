          {
            "url": "https://www.libdems.org.uk/manifesto",
            "publisher": "libdems.org.uk",
            "source_type": "manifesto"
          }
        ]
      },
      {
        "evidence_id": "E1",
        "snippet": "**Current State and Proposed Changes:**\nAt the end of 2025, the initial decision asylum backlog stood at 49,000 applications, marking a 46% reduction from the previous year and the lowest level since 2020.",
        "sources": [
          {
            "url": "https://migrationobservatory.ox.ac.uk/resources/briefings/the-uks-asylum-backlog/",
            "publisher": "migrationobservatory.ox.ac.uk",
