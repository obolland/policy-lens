{
  "policy_id": "ld-126-new-right-to-flexible-working-and",
  "party": "Liberal Democrat",
  "policy_title": "New Right to Flexible Working and Work from Home for Disabled People",
  "outcome": "O4",
  "verdict": {
    "outcome": "O4",
    "direction": "improves",
    "magnitude": "moderate",
    "time_horizon": "this-parliament",
    "confidence": "moderate",
    "plain": "Giving everyone a right to flexible working and disabled people a right to work from home would likely improve job security and employment for disabled workers, who currently face a huge employment gap. The main caveat is that enforcement has historically been weak and the 'significant business reasons' loophole could limit real-world impact.",
    "biggest_unknown": "Whether the 'significant business reasons' exemption will be tightly defined and enforced, or will replicate the weaknesses of existing reasonable adjustment duties that employers routinely ignore.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy gives everyone a new right to flexible working and every disabled person the right to work from home unless there are significant business reasons why it is not possible.",
        "evidence_id": "M",
        "quote": "Give everyone a new right to flexible working and every disabled person the right to work from home if they want to, unless there are significant business reasons why it is not possible."
      },
      {
        "tier": "measurable",
        "claim": "Many disabled people require flexibility to manage their conditions, attend medical appointments, and mitigate the impact of fatigue or pain.",
        "evidence_id": "E7",
        "quote": "Many disabled people require flexibility to manage their conditions, attend medical appointments, and mitigate the impact of fatigue or pain"
      },
      {
        "tier": "measurable",
        "claim": "70% of disabled workers said not being allowed to work remotely would negatively impact their health.",
        "evidence_id": "E11",
        "quote": "A Work Foundation survey found 70% of disabled workers said not being allowed to work remotely would negatively impact their health"
      },
      {
        "tier": "measurable",
        "claim": "85% of disabled workers reported being more productive when working from home.",
        "evidence_id": "E12",
        "quote": "A Work Foundation survey found that 85% of disabled workers reported being more productive when working from home"
      },
      {
        "tier": "measurable",
        "claim": "Existing law is already considered weaker than needed \u2014 the right to request flexible working is weaker than the reasonable adjustments duty under the Equality Act for disabled workers.",
        "evidence_id": "E4",
