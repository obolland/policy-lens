        "evidence_id": "E13",
        "quote": "42% of respondents with no photo ID stating they would be unlikely or very unlikely to apply"
      },
      {
        "tier": "measurable",
        "claim": "Currently 16- and 17-year-olds cannot vote in UK general elections or local elections in England, though they can in Scottish Parliament and Senedd elections.",
        "evidence_id": "E17",
        "quote": "16 and 17-year-olds can vote in local council elections and Scottish Parliament and Senedd elections in Scotland and Wales, but not in UK general elections, local elections in England"
      }
