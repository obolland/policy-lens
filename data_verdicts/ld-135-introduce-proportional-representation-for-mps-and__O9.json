      },
      {
        "tier": "projected",
        "claim": "In multi-member constituencies, parties may field more balanced candidate teams, improving representation of women and ethnic minority candidates.",
        "evidence_id": "E19",
        "quote": "parties may field more balanced teams of candidates, promoting the advancement of women and ethnic minority candidates who might be overlooked under FPTP"
      },
      {
