  "party": "Liberal Democrat",
  "policy_title": "Introduce Proportional Representation for MPs and Local Councillors",
  "outcome": "O9",
  "verdict": {
    "outcome": "O9",
    "direction": "improves",
    "magnitude": "major",
    "time_horizon": "long-term",
    "confidence": "moderate",
    "plain": "Replacing First Past the Post with STV would make votes count more equally \u2014 seats would better reflect actual voter support and far fewer votes would be 'wasted'. Full implementation requires primary legislation and constituency boundary redrawing, so real-world effects are long-term.",
    "biggest_unknown": "Whether the legislative process, boundary reviews, and transition can be delivered, and how multi-member constituency design affects local democratic accountability.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy commits to introducing proportional representation by STV for electing MPs and local councillors in England.",
        "evidence_id": "M",
        "quote": "introducing proportional representation by the Single Transferable Vote for electing MPs, and local councillors in England"
      },
      {
        "tier": "measurable",
        "claim": "Under the current FPTP system, Labour secured 63.2% of seats with only 33.5% of the national vote in 2024, while Reform UK gained 14.3% of votes but only 0.8% of seats \u2014 a severe mismatch between votes and representation.",
        "evidence_id": "E2",
        "quote": "Labour secured 63.2% of seats with only 33.5% of the national vote, while Reform UK gained 14.3% of votes but only 0.8% of seats"
      },
      {
        "tier": "measurable",
        "claim": "70% of constituencies are considered 'safe' under FPTP, meaning most voters live in seats where their vote has no realistic effect on the outcome.",
        "evidence_id": "E11",
        "quote": "70% of constituencies are considered \"safe\" under the current First Past the Post (FPTP) system"
      },
      {
        "tier": "projected",
        "claim": "Under STV, the distribution of parliamentary seats would more closely reflect the proportion of votes cast for each party, reducing democratic distortion.",
