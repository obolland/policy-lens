  "policy_title": "End Gender Price Gap and Period Poverty",
  "outcome": "O2",
  "verdict": {
    "outcome": "O2",
    "direction": "improves",
    "magnitude": "moderate",
    "time_horizon": "this-parliament",
    "confidence": "moderate",
    "plain": "This policy would cut costs for women by banning higher prices on identical products and making period products free \u2014 both directly reducing what lower-income women spend on essentials. The main uncertainty is whether a gender-pricing ban can be enforced effectively in practice.",
    "biggest_unknown": "Whether legislation banning gender-based price disparities can be practically enforced across retail markets, and how widely free period products would be accessed given ongoing stigma barriers.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy would end the gender price gap so women are not charged more than men for practically identical products, and introduce a right to free period products for anyone who needs them.",
        "evidence_id": "M",
        "quote": "Ending the gender price gap so that women are not charged more than men for practically identical products or services marketed at them. Ending period poverty by introducing a right for anyone who needs them to access free period products."
      },
      {
        "tier": "measurable",
        "claim": "Women paid nearly 40% extra on average for lower-cost toiletry essentials compared to men.",
        "evidence_id": "E1",
        "quote": "women paid nearly 40% extra on average for lower-cost toiletry essentials"
      },
      {
        "tier": "measurable",
        "claim": "Research found price disparities across gender-targeted items with women's products being 37% more expensive on average.",
