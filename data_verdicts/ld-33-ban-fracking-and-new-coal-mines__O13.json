      {
        "tier": "measurable",
        "claim": "The UK's last coal-fired power station closed in October 2024, making the energy-supply dimension of the coal ban largely symbolic.",
        "evidence_id": "E17",
        "quote": "the closure of the UK's last coal-fired power station in October 2024."
      },
