      },
      {
        "tier": "projected",
        "claim": "Prevention-focused approaches are argued to be more cost-effective than dealing with homelessness consequences, suggesting potential long-run fiscal savings.",
        "evidence_id": "E42",
        "quote": "preventing homelessness is more cost-effective than dealing with its consequences"
