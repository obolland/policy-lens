      {
        "tier": "projected",
        "claim": "Sector organisations have stated that existing funding has not been enough to solve the problem, implying further pressure on future spending.",
        "evidence_id": "E44",
        "quote": "organizations like Shelter have previously stated that existing funding has not been enough to solve the problem."
      }
