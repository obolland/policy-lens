{
  "policy_id": "ref-17-abolish-ir35-rules",
  "party": "Reform UK",
  "policy_title": "Abolish IR35 rules",
  "outcome": "O2",
  "verdict": {
    "outcome": "O2",
    "direction": "mixed",
    "magnitude": "minor",
    "time_horizon": "this-parliament",
    "confidence": "moderate",
    "plain": "Abolishing IR35 would raise take-home pay for contractors currently treated as inside the rules, but the ~\u00a32 billion annual revenue cost risks squeezing public finances in ways that could affect ordinary households. The gains flow mainly to higher-earning contractors, not lower-income households.",
    "biggest_unknown": "Whether the fiscal shortfall (circa \u00a32bn/year) is offset by growth in contractor activity, or instead leads to spending cuts or tax rises that hurt ordinary households more than the take-home gains help contractors.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy aims to abolish IR35 rules entirely to support sole traders.",
        "evidence_id": "M",
        "quote": "Reform UK will abolish IR35 rules to support sole traders"
      },
      {
        "tier": "measurable",
        "claim": "IR35 rules exist to ensure self-employed workers pay broadly the same tax as employees, countering tax avoidance.",
        "evidence_id": "E1",
        "quote": "The legislation aims to ensure these workers pay broadly the same Income Tax and National Insurance Contributions (NICs) as employees, thereby countering tax avoidance"
      },
      {
        "tier": "measurable",
        "claim": "The 2017 and 2021 reforms raised around \u00a34.2 billion in additional tax and NICs in three years.",
        "evidence_id": "E8",
        "quote": "HMRC estimated that the 2017 and 2021 reforms raised around \u00a34.2 billion in additional tax and NICs in the three years to March 2023"
      },
      {
        "tier": "measurable",
        "claim": "Abolition would cost around \u00a32 billion a year in lost revenue.",
        "evidence_id": "E9",
        "quote": "The Resolution Foundation noted the cancelled 2022 repeal would have cost around \u00a32 billion a year"
      },
      {
        "tier": "measurable",
        "claim": "There is a large tax gap between employees and the self-employed \u2014 a typical self-employed worker pays approximately 55% less in total labour tax than an employee on the same gross pay.",
        "evidence_id": "E7",
        "quote": "a typical self-employed worker pays approximately 55% less in total labour tax than an employee earning the same gross pay (2025-26 estimate), representing an 11-percentage-point tax gap in gross income"
      },
      {
