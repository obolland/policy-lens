        "claim": "Only 1.1% of students in alternative provision attained five A*-C GCSEs in 2016, compared to 53.5% in mainstream schools.",
        "evidence_id": "E9",
        "quote": "In 2016, only 1.1% of students in alternative provision (which includes PRUs) attained five A*-C GCSEs, compared to 53.5% in mainstream schools"
      },
      {
        "tier": "measurable",
        "claim": "PRU placements intended as temporary often become permanent, limiting reintegration chances for excluded pupils.",
        "evidence_id": "E27",
        "quote": "placements in PRUs often become permanent, especially for older pupils, limiting their chances of reintegration into mainstream education"
      },
      {
        "tier": "projected",
        "claim": "Doubling PRUs would likely worsen existing staffing challenges for specialist teachers.",
        "evidence_id": "E23",
        "quote": "Doubling the number would likely exacerbate these staffing challenges, particularly for teachers with expertise in trauma, mental health, and re-engagement"
      },
      {
        "tier": "projected",
        "claim": "The effectiveness of PRUs in consistently achieving positive outcomes and reintegrating students is debated.",
        "evidence_id": "E24",
        "quote": "the effectiveness of PRUs in consistently achieving positive outcomes and reintegrating students is debated"
      }
