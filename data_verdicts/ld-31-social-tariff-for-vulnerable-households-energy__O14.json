  "party": "Liberal Democrat",
  "policy_title": "Social Tariff for Vulnerable Households' Energy Bills",
  "outcome": "O14",
  "verdict": {
    "outcome": "O14",
    "direction": "improves",
    "magnitude": "moderate",
    "time_horizon": "this-parliament",
    "confidence": "moderate",
    "plain": "A targeted energy social tariff directs meaningful bill discounts to the poorest households, narrowing the gap between high- and low-income households on a significant spending item. The distributional gain is real but the size depends heavily on how the scheme is funded \u2014 taxation is far less regressive than cross-subsidy.",
    "biggest_unknown": "Whether the tariff is funded through general taxation (progressive, less regressive) or cross-subsidy on non-eligible households' bills (partly regressive) fundamentally determines the net distributional effect.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy commits to targeted energy discounts for vulnerable households via a social tariff.",
        "evidence_id": "M",
        "quote": "Introduce a social tariff for the most vulnerable to provide targeted energy discounts for vulnerable households."
      },
      {
        "tier": "measurable",
        "claim": "There were approximately 9 million fuel-poor households in England in 2024, defined as spending more than 10% of income on energy.",
        "evidence_id": "E15",
        "quote": "There were 9 million fuel-poor households in England in 2024, based on the definition of spending more than 10% of income on energy."
      },
      {
        "tier": "projected",
        "claim": "CPAG projects the tariff could more than halve the fuel poverty rate, from around 20% to 9.2%.",
        "evidence_id": "E2",
        "quote": "The Child Poverty Action Group (CPAG) suggests it could more than halve the fuel poverty rate, potentially decreasing it from 20% to 9.2%."
      },
      {
        "tier": "projected",
        "claim": "The JRF identifies the tariff as having the potential to increase incomes particularly for the lowest-income households.",
        "evidence_id": "E20",
        "quote": "the potential for a social tariff to increase incomes across the income distribution, particularly for the lowest-income households."
      },
      {
        "tier": "projected",
        "claim": "Funding through general taxation is considered less regressive and less economically damaging than levies on energy bills.",
        "evidence_id": "E29",
        "quote": "Funding through general taxation is generally considered less regressive and less damaging to the economy than placing levies on energy bills."
      },
      {
        "tier": "projected",
        "claim": "If funded through cross-subsidy, non-eligible households could face slightly higher bills, creating a modest regressive side-effect for near-threshold households.",
        "evidence_id": "E30",
        "quote": "If funded through cross-subsidies, there is a risk that non-eligible households could face slightly higher bills, potentially pushing some just above the eligibility threshold into financial strain."
      },
      {
        "tier": "projected",
        "claim": "A social tariff would be more effectively targeted at low-income households than blanket measures like the Energy Price Guarantee.",
        "evidence_id": "E5",
        "quote": "a social tariff would provide more effective and targeted support than previous blanket measures (like the Energy Price Guarantee) or current cost-of-living payments."
