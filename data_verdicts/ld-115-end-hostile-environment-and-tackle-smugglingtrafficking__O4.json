      {
        "tier": "measurable",
        "claim": "The Hostile Environment restricted access to employment for those unable to prove legal right to remain.",
        "evidence_id": "E1",
        "quote": "restricting access to employment, housing, bank accounts, driving licenses, benefits, and free healthcare for those unable to prove their legal right to remain"
      },
      {
        "tier": "measurable",
        "claim": "Recent legislation has significantly diminished protections for modern slavery victims.",
        "evidence_id": "E16",
        "quote": "the Nationality and Borders Act 2022 and the Illegal Migration Act 2023 (IMA), has significantly diminished protections for victims of modern slavery"
      },
      {
        "tier": "measurable",
        "claim": "Current law allows denial of support, detention and deportation of potential modern slavery victims, deterring them from coming forward.",
        "evidence_id": "E18",
        "quote": "This has created a \"growing culture of disbelief\" in victims and deterred them from coming forward, making identification harder"
      },
      {
