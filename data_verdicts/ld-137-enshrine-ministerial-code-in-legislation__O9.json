      },
      {
        "tier": "measurable",
        "claim": "Historically the Adviser needed the Prime Minister's consent to begin investigations.",
        "evidence_id": "E5",
        "quote": "Historically, the Adviser required the Prime Minister's consent to initiate investigations into alleged breaches"
      },
