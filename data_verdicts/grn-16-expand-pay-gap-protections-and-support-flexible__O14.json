{
  "policy_id": "grn-16-expand-pay-gap-protections-and-support-flexible",
  "party": "Green",
  "policy_title": "Expand pay-gap protections and support flexible working",
  "outcome": "O14",
  "verdict": {
    "outcome": "O14",
    "direction": "improves",
    "magnitude": "minor",
    "time_horizon": "long-term",
    "confidence": "low",
    "plain": "Extending pay-gap reporting to ethnicity, disability, and sexual orientation could modestly narrow pay disparities that currently run at 12\u201313% for disabled and Black employees, but evidence from gender pay gap reporting suggests effects are small and slow, and the policy's 'push for' framing commits to no concrete instrument. The main caveat is whether reporting without enforcement targets produces meaningful redistribution.",
    "biggest_unknown": "Whether mandatory reporting alone \u2014 without accompanying enforcement powers or binding pay targets \u2014 translates into actual pay increases for affected groups rather than a 'tick-box' compliance exercise.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy proposes extending pay-gap protections to ethnicity, disability, and sexual orientation, covering equal pay and flexible working.",
