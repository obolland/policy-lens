      },
      {
        "tier": "measurable",
        "claim": "There is already a mandatory minimum sentence for a second conviction of possessing an offensive weapon or bladed article.",
        "evidence_id": "E21",
        "quote": "There is also a mandatory minimum sentence for a second conviction of possessing an offensive weapon or bladed article"
      },
      {
        "tier": "projected",
        "claim": "Mandatory minimum sentences limit judicial discretion, which critics argue can lead to rigid penalties that may not fit individual circumstances.",
        "evidence_id": "E22",
        "quote": "Mandatory minimum sentences limit judicial discretion, which critics argue can lead to rigid penalties that may not fit individual circumstances"
      },
      {
        "tier": "projected",
        "claim": "Stop and search's disproportionate use on ethnic minorities can lead to mistrust, trauma, and poorer mental and physical health outcomes.",
        "evidence_id": "E15",
        "quote": "Stop and search is a controversial police power due to its disproportionate use on ethnic minorities, particularly young Black men, which can lead to mistrust, trauma, and poorer mental and physical health outcomes"
      }
