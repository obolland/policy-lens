{
  "policy_id": "ref-33-implement-zero-tolerance-policing",
  "party": "Reform UK",
  "policy_title": "Implement zero-tolerance policing",
  "outcome": "O10",
  "verdict": {
    "outcome": "O10",
    "direction": "worsens",
    "magnitude": "moderate",
    "time_horizon": "immediate",
    "confidence": "moderate",
    "plain": "This policy substantially expands stop and search, introduces mandatory prison sentences, and creates new criminal offences \u2014 all of which increase state coercive power over individuals' bodies and choices. The main caveat is that some of these powers already exist in law, so the marginal liberty cost depends on how aggressively they are applied.",
    "biggest_unknown": "How much additional coercive power is genuinely new versus already on the statute book, and whether courts would apply mandatory sentences rigidly or find departures.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy substantially increases stop and search.",
        "evidence_id": "M",
        "quote": "substantially increasing Stop and Search"
      },
      {
