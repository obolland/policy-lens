  "party": "Conservative",
  "policy_title": "Pay Infected Blood Compensation",
  "outcome": "O2",
  "verdict": {
    "outcome": "O2",
    "direction": "improves",
    "magnitude": "moderate",
    "time_horizon": "this-parliament",
    "confidence": "moderate",
    "plain": "This policy pays substantial financial compensation to people harmed by contaminated blood products, directly improving their ability to afford essentials after years of hardship. The main caveat is that payments are rolling out slowly, and many eligible people are still waiting \u2014 some dying before receiving anything.",
    "biggest_unknown": "Whether the scheme will accelerate payments quickly enough to reach the tens of thousands still waiting, given that as of May 2026 only around 3,200 of over 18,500 registered claimants had received payments.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy commits to a further \u00a3210,000 interim payment to living infected beneficiaries, accepting inquiry principles for comprehensive compensation.",
