        "claim": "Erasmus+ extends beyond higher education to include vocational education, school exchanges, and adult learning.",
        "evidence_id": "E12",
        "quote": "Erasmus+ extends beyond traditional higher education exchanges to include vocational education and training, school exchanges, and adult learning"
      },
      {
        "tier": "projected",
        "claim": "The UK's financial contribution for 2027 is approximately \u00a3570 million, including a 30% discount.",
        "evidence_id": "E20",
        "quote": "The UK's financial contribution for its association with Erasmus+ in 2027 is approximately \u00a3570 million, which includes a negotiated 30% discount on the default contribution rate."
      },
      {
        "tier": "measurable",
        "claim": "The government has stated it will review data from 2027/28 before deciding on continued participation.",
        "evidence_id": "E33",
        "quote": "The UK government has stated it will review data from the first year of association (2027/28) to inform decisions on continued participation beyond 2027."
      }
