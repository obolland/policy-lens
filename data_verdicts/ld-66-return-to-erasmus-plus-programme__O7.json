  "verdict": {
    "outcome": "O7",
    "direction": "improves",
    "magnitude": "moderate",
    "time_horizon": "long-term",
    "confidence": "moderate",
    "plain": "Rejoining Erasmus+ would restore international study, teaching, and volunteering opportunities for thousands of UK young people, with grants covering costs and extra support for disadvantaged participants. The main caveat is that placements don't start until 2027/28 and the government has flagged it will review continued participation after just one year.",
    "biggest_unknown": "Whether the UK commits beyond the initial 2027/28 year and whether the \u00a3570 million annual cost is judged affordable long-term, which could see the programme cancelled again.",
    "claims": [
      {
        "tier": "stated",
        "claim": "The policy aims to expand opportunities for young people to study, teach and volunteer abroad by returning to Erasmus+ as an associated country.",
        "evidence_id": "M",
        "quote": "Expand opportunities for young people to study, teach and volunteer abroad by returning to the Erasmus Plus programme as an associated country."
      },
      {
        "tier": "measurable",
        "claim": "The UK left Erasmus+ in 2020 after Brexit and replaced it with the domestic Turing Scheme.",
        "evidence_id": "E2",
        "quote": "This move follows the UK's departure from the programme in 2020 after Brexit and the subsequent introduction of the domestic Turing Scheme."
      },
      {
        "tier": "measurable",
        "claim": "Before leaving, Erasmus+ accounted for almost half of all UK students studying abroad.",
        "evidence_id": "E13",
        "quote": "Erasmus+ was a critical element in the UK's outward mobility strategy before Brexit, accounting for almost half (49.2%) of all instances of UK students studying abroad in 2015/16."
      },
      {
        "tier": "measurable",
        "claim": "The Turing Scheme did not fund tuition fees, unlike Erasmus+.",
        "evidence_id": "E5",
        "quote": "This is a crucial difference from the Turing Scheme, which did not fund tuition fees."
      },
      {
        "tier": "measurable",
        "claim": "The Turing Scheme also lacked funding for staff placements or incoming students from the EU.",
        "evidence_id": "E14",
