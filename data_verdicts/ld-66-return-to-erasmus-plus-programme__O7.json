        "evidence_id": "E21",
        "quote": "The UK government expects 100,000 people to benefit in the first year alone."
      },
      {
        "tier": "projected",
        "claim": "Erasmus+ placements for UK participants will commence in the 2027/28 academic year.",
        "evidence_id": "E1",
        "quote": "placements commencing in the 2027/28 academic year."
      },
      {
        "tier": "stated",
        "claim": "Erasmus+ offers grants covering tuition, travel, accommodation, and living costs, with additional support for disadvantaged participants and those with disabilities.",
        "evidence_id": "E4",
        "quote": "Erasmus+ offers grants that cover tuition, travel, accommodation, and living costs, with additional support available for participants from disadvantaged backgrounds and those with disabilities."
      },
      {
