        "tier": "projected",
        "claim": "The Accord Coalition warns lifting the cap could lead to schools becoming 'cultural silos'.",
        "evidence_id": "E19",
        "quote": "scrapping the cap could lead to schools becoming \"cultural silos\""
      },
      {
        "tier": "projected",
        "claim": "The government argues the existing cap has not significantly improved diversity, and all faith schools will still be required to promote community cohesion and fundamental British values.",
        "evidence_id": "E20",
        "quote": "the cap has not significantly improved diversity and that all faith-designated free schools will still be required to demonstrate their commitment to community cohesion and promote fundamental British values"
      },
      {
        "tier": "measurable",
        "claim": "A 2017 poll commissioned by the Accord Coalition found four out of five voters preferred to maintain the 50% cap, including a majority from every religious group.",
        "evidence_id": "E21",
        "quote": "four out of five voters preferred to maintain the 50% cap, including a majority from every religious group"
      }
