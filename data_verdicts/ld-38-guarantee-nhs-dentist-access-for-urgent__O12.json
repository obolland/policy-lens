  "verdict": {
    "outcome": "O12",
    "direction": "worsens",
    "magnitude": "minor",
    "time_horizon": "this-parliament",
    "confidence": "low",
    "plain": "This policy would require significant new public spending on NHS dentistry, but states no funding source \u2014 meaning the cost would likely be borrowed or found from elsewhere. The true fiscal hit is uncertain because no costing is provided.",
    "biggest_unknown": "Whether the policy is funded by new money, reallocation within the existing dental budget, or borrowing \u2014 none of which is specified in the policy text.",
    "claims": [
      {
