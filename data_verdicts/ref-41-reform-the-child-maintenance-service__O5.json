      },
      {
        "tier": "measurable",
        "claim": "UK Parliament has explicitly not enacted a presumption of 50/50 shared care despite decade of reforms.",
        "evidence_id": "E22",
        "quote": "the UK Parliament has explicitly *not* enacted a presumption of 50/50 shared care"
      },
